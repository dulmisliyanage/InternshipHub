datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  status    String   @default("ok")
  message   String   @default("Database connection successful")
  createdAt DateTime @default(now())
}
