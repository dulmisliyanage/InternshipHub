datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum InternshipStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum InternshipSkillType {
  REQUIRED
  PREFERRED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  provider     AuthProvider
  role         Role
  status       AccountStatus @default(ACTIVE)
  profileImage String?

  studentProfile StudentProfile?
  companyProfile CompanyProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  university         String?
  degree             String?
  fieldOfStudy       String?
  currentYear        Int?
  expectedGraduation DateTime?
  location           String?

  preferredRole     String?
  preferredWorkType WorkType?

  bio          String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  cvUrl        String?

  skills StudentSkill[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id     String @id @default(cuid())
  userId String @unique

  companyName String
  industry    String?
  companySize CompanySize?
  location    String?

  website     String?
  linkedinUrl String?
  logoUrl     String?

  description String?

  internships Internship[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Internship {
  id                  String           @id @default(cuid())
  companyProfileId    String
  title               String
  category            String?
  description         String
  responsibilities    String?
  location            String?
  workType            WorkType
  duration            String?
  allowanceMin        Int?
  allowanceMax        Int?
  currency            String?          @default("LKR")
  positions           Int              @default(1)
  applicationDeadline DateTime?
  status              InternshipStatus @default(DRAFT)
  publishedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  companyProfile CompanyProfile    @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  skills         InternshipSkill[]

  @@index([companyProfileId])
  @@index([status])
  @@index([workType])
  @@index([applicationDeadline])
}

model InternshipSkill {
  id           String              @id @default(cuid())
  internshipId String
  skillId      String
  type         InternshipSkillType @default(REQUIRED)
  createdAt    DateTime            @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([internshipId, skillId])
  @@index([internshipId])
  @@index([skillId])
  @@index([type])
}

model SkillCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         String @id @default(cuid())
  name       String @unique
  categoryId String

  category SkillCategory @relation(fields: [categoryId], references: [id])

  studentSkills    StudentSkill[]
  internshipSkills InternshipSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentSkill {
  id               String           @id @default(cuid())
  studentProfileId String
  skillId          String
  proficiency      ProficiencyLevel

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  status    String   @default("ok")
  message   String   @default("Database connection successful")
  createdAt DateTime @default(now())
}
