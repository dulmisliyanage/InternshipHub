datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  provider     AuthProvider
  role         Role
  status       AccountStatus @default(ACTIVE)
  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  status    String   @default("ok")
  message   String   @default("Database connection successful")
  createdAt DateTime @default(now())
}
